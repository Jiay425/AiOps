CODEOPS_LLM_TIMEOUT_SECONDS=120
CODEOPS_LLM_MAX_OUTPUT_TOKENS=2048
CODEOPS_LLM_AGENT_LOOP_MAX_OUTPUT_TOKENS=4096
CODEOPS_LLM_EMPTY_CONTENT_RETRIES=2
